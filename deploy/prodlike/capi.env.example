# Non-secret API settings for compose.prodlike.yaml.
# Copy to deploy/prodlike/capi.env (gitignored) and fill in real values.
# Secrets (DB URL, R2 keys, YouTube API key) are NOT set here: they come from
# ./.secrets/ as Compose file secrets and are read through *_FILE variables.
R2_ACCOUNT_ID=replace-me
R2_BUCKET_NAME=replace-me
R2_PUBLIC_URL=https://images.example.com
YOUTUBE_BASE_URL=https://www.googleapis.com/youtube/v3
YOUTUBE_CHANNEL_HANDLE=@replace-me
# CORS_ORIGINS intentionally unset: the app is served same-origin.
