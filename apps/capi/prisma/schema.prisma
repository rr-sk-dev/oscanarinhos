// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "cjs"
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "postgresql"
}

model Team {
  id        String  @id @default(uuid()) @db.Uuid
  name      String  @unique
  shortName String?
  logo      String
  teamPhoto String?

  /// [TeamWebContent]
  webContent Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  homeMatches Match[] @relation("HomeMatches")
  awayMatches Match[] @relation("AwayMatches")

  players Player[]
  staff   TeamStaff[]

  memberships Membership[]
  invites     Invite[]
  events      Event[]
  eventSeries EventSeries[]
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  FINISHED
  POSTPONED
  CANCELED
}

model Match {
  id         String      @id @default(uuid()) @db.Uuid
  journey    Int
  kickoffAt  DateTime
  label      String
  status     MatchStatus @default(SCHEDULED)
  homeTeamId String      @db.Uuid
  awayTeamId String      @db.Uuid
  homeScore  Int?
  awayScore  Int?
  location   String?
  videoId    String?

  /// [MatchEvent[]]
  events Json?

  /// [MatchLineup]
  lineups Json?

  event Event?

  homeTeam Team @relation("HomeMatches", fields: [homeTeamId], references: [id])
  awayTeam Team @relation("AwayMatches", fields: [awayTeamId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([journey])
  @@index([status])
  @@index([kickoffAt])
}

enum PlayerPosition {
  GK
  DEF
  MID
  FWD
}

enum PlayerFoot {
  LEFT
  RIGHT
  BOTH
}

enum PlayerStatus {
  ACTIVE
  INJURED
  SUSPENDED
  UNAVAILABLE
  RETIRED
}

enum LeadershipRole {
  NONE
  CAPTAIN
  VICE_CAPTAIN
}

model Player {
  id             String         @id @default(uuid()) @db.Uuid
  firstName      String
  lastName       String
  fullName       String
  nickname       String?
  shirtNumber    Int?
  position       PlayerPosition
  preferredFoot  PlayerFoot
  dateOfBirth    DateTime?
  photo          String?
  bio            String?
  status         PlayerStatus   @default(ACTIVE)
  leadershipRole LeadershipRole @default(NONE)
  teamId         String         @db.Uuid
  team           Team           @relation(fields: [teamId], references: [id])

  memberships Membership[]
  invites     Invite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, shirtNumber])
  @@index([teamId])
  @@index([status])
  @@index([position])
}

enum StaffRole {
  COACH
  ASSISTANT_COACH
  DELEGATE
  PHYSICAL_PREPARATOR
}

model TeamStaff {
  id          String    @id @default(uuid()) @db.Uuid
  firstName   String
  lastName    String
  role        StaffRole
  dateOfBirth DateTime?
  photo       String?
  bio         String?
  teamId      String    @db.Uuid
  team        Team      @relation(fields: [teamId], references: [id])

  memberships Membership[]
  invites     Invite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([role])
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model News {
  id          String     @id @default(uuid()) @db.Uuid
  title       String
  slug        String     @unique
  excerpt     String
  content     String
  image       String?
  author      String
  status      NewsStatus @default(DRAFT)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([author])
  @@index([publishedAt])
  @@index([createdAt])
}

model Standing {
  id             String  @id @default(uuid()) @db.Uuid
  season         String
  position       Int
  teamName       String
  teamLogo       String?
  gamesPlayed    Int     @default(0)
  wins           Int     @default(0)
  draws          Int     @default(0)
  losses         Int     @default(0)
  goalsFor       Int     @default(0)
  goalsAgainst   Int     @default(0)
  goalDifference Int     @default(0)
  points         Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([season])
  @@index([teamName])
}

model Scorer {
  id         String @id @default(uuid()) @db.Uuid
  season     String
  rank       Int
  playerName String
  teamName   String
  goals      Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([season])
  @@index([playerName])
}

model Testimonial {
  id       String  @id @default(uuid()) @db.Uuid
  quote    String
  author   String
  role     String
  initials String  @db.VarChar(4)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

enum MembershipRole {
  ADMIN
  COACH
  PLAYER
  STAFF
}

enum EventType {
  TRAINING
  GAME
  CUSTOM
}

enum EventStatus {
  SCHEDULED
  CANCELED
}

enum AvailabilityAnswer {
  YES
  NO
  MAYBE
}

model User {
  id    String  @id @default(uuid()) @db.Uuid
  /// Always stored lowercase (enforced in code).
  email String  @unique
  name  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
}

model Membership {
  id       String         @id @default(uuid()) @db.Uuid
  userId   String         @db.Uuid
  teamId   String         @db.Uuid
  role     MembershipRole
  playerId String?        @db.Uuid
  staffId  String?        @db.Uuid

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  team   Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player?    @relation(fields: [playerId], references: [id], onDelete: SetNull)
  staff  TeamStaff? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitesCreated Invite[]
  availabilities Availability[]
  attendances    Attendance[]

  @@unique([userId, teamId])
  @@index([teamId])
}

model Invite {
  id                    String         @id @default(uuid()) @db.Uuid
  teamId                String         @db.Uuid
  role                  MembershipRole
  code                  String         @unique
  playerId              String?        @db.Uuid
  staffId               String?        @db.Uuid
  maxUses               Int
  uses                  Int            @default(0)
  expiresAt             DateTime
  createdByMembershipId String         @db.Uuid

  team      Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player    Player?    @relation(fields: [playerId], references: [id], onDelete: SetNull)
  staff     TeamStaff? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  createdBy Membership @relation(fields: [createdByMembershipId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model LoginCode {
  id         String    @id @default(uuid()) @db.Uuid
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([email])
}

model EventSeries {
  id              String   @id @default(uuid()) @db.Uuid
  teamId          String   @db.Uuid
  title           String
  location        String?
  weekdays        Int[]
  /// "HH:mm"
  startTime       String
  durationMinutes Int
  startDate       DateTime
  endDate         DateTime

  team   Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id        String      @id @default(uuid()) @db.Uuid
  teamId    String      @db.Uuid
  type      EventType
  title     String
  startsAt  DateTime
  endsAt    DateTime?
  location  String?
  notes     String?
  respondBy DateTime?
  status    EventStatus @default(SCHEDULED)
  matchId   String?     @unique @db.Uuid
  seriesId  String?     @db.Uuid

  team   Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  match  Match?       @relation(fields: [matchId], references: [id], onDelete: SetNull)
  series EventSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  availabilities Availability[]
  attendances    Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId, startsAt])
}

model Availability {
  id           String             @id @default(uuid()) @db.Uuid
  eventId      String             @db.Uuid
  membershipId String             @db.Uuid
  answer       AvailabilityAnswer
  note         String?

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, membershipId])
}

model Attendance {
  id           String  @id @default(uuid()) @db.Uuid
  eventId      String  @db.Uuid
  membershipId String  @db.Uuid
  attended     Boolean

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, membershipId])
}
